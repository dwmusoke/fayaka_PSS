# Local (SQLite) - default, no env needed
PORT=8000

# Supabase / PostgreSQL (production)
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# SUPABASE_DB_URL=postgresql://...
# HOST=0.0.0.0

# Session cookies: set 0 only when running over plain http for internal dev
SECURE_COOKIES=1

# Login lockout (per account + client IP; 5 failures / 15 min by default)
# LOGIN_LOCKOUT_MAX=5
# LOGIN_LOCKOUT_SECONDS=900
# LOGIN_LOCKOUT_DISABLED=1
